{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "ft-duokeys",
  "description": "ft-duokeys: a hand's buttons, all of them, while its ray is on the keyboard",
  "bindings": {
    "/actions/duokeys_left": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/view",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_up",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_left",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_right",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/duokeys_left/in/stick"
            },
            "click": {
              "output": "/actions/duokeys_left/in/other"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/duokeys_left/out/haptic",
          "path": "/user/hand/left/output/haptic"
        }
      ]
    },
    "/actions/duokeys_right": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/duokeys_right/in/stick"
            },
            "click": {
              "output": "/actions/duokeys_right/in/other"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/duokeys_right/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}